# Public site URL, used for auth redirects and Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (ONA Functional Phase 1: Google OAuth + passwordless email auth,
# the 72-hour full-platform trial, RLS-protected `platform_access` table).
# See docs/supabase-setup.md for how to create these values.
#
# Both variables below are safe to expose to the browser (that's what
# NEXT_PUBLIC_ means here) — the publishable key only ever acts as the
# authenticated user, subject to Row Level Security. Required for the app
# to treat any visitor as signed in; without them every page falls back to
# the signed-out state (see src/platform/access/getPlatformAccess.ts).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is what Supabase's dashboard may
# still label "anon public" on older projects — same key, current name. Do
# NOT use NEXT_PUBLIC_SUPABASE_ANON_KEY; it is not read anywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by src/platform/supabase/admin.ts (ONA Functional Phase 2 —
# Stripe billing sync) to write public.platform_billing, since RLS
# deliberately makes that table select-only for the authenticated client.
# NEVER add the NEXT_PUBLIC_ prefix to this — it bypasses Row Level
# Security entirely and must never reach client code. Not used anywhere
# else (trial-row creation still runs entirely inside the Phase 1 database
# trigger, without this key).
SUPABASE_SECRET_KEY=

# Stripe (ONA Functional Phase 2 — ONA Pro subscriptions via Stripe-hosted
# Checkout with Managed Payments; see docs/stripe-billing-setup.md).
# Server-only — never NEXT_PUBLIC_. STRIPE_SECRET_KEY and both Price IDs
# are required for src/app/api/stripe/checkout to work.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=

# Deliberately left unset until the webhook endpoint has been deployed and
# registered in the Stripe Dashboard — see docs/stripe-billing-setup.md for
# the exact steps. Without it, src/app/api/stripe/webhook fails closed
# (503) rather than processing anything unverified; the rest of the app
# (including `next build`) does not depend on this variable at all.
STRIPE_WEBHOOK_SECRET=
