# Public site URL, used for auth redirects and (later) Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (ONA Functional Phase 1: Google OAuth + passwordless email auth,
# the 72-hour full-platform trial, RLS-protected `platform_access` table).
# See docs/supabase-setup.md for how to create these values.
#
# Both variables below are safe to expose to the browser (that's what
# NEXT_PUBLIC_ means here) — the anon key only ever acts as the
# authenticated user, subject to Row Level Security. Required for the app
# to treat any visitor as signed in; without them every page falls back to
# the signed-out state (see src/platform/access/getPlatformAccess.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT used by any application code as of ONA Functional Phase 1. Trial-row
# creation runs entirely inside a SECURITY DEFINER Postgres trigger (see
# supabase/migrations/), specifically so the app never needs this key. Keep
# it out of any NEXT_PUBLIC_ variable and never import it into client code —
# it bypasses Row Level Security entirely. Reserved for a future phase
# (e.g. Stripe webhook handlers) that genuinely needs server-side elevated
# access.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (future billing phase — NOT part of ONA Functional Phase 1: single
# Annual Platform Pro license, no Lifetime product; see docs/product-spec.md §25)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ANNUAL=
